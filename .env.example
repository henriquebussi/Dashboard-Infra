# =============================================================================
# GCP FinOps Observatory — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# The backend loads this file automatically via python-dotenv.
# Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — GCP Integration
# -----------------------------------------------------------------------------

# GCP project that owns the Cloud Monitoring / Logging data.
# Use the PROJECT ID (e.g. my-project-123456), NOT an OAuth Client ID
# (values ending in .apps.googleusercontent.com) and NOT an API key.
# Find it in Google Cloud Console → project selector → "Project ID".
# Leave empty to run the dashboard with the built-in overview API
# (live GCP metrics will be disabled).
GCP_PROJECT_ID=your-gcp-project-id

# Path to a GCP service-account key JSON file (optional).
# If omitted, Application Default Credentials (ADC) are used:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Backend — Redis Cache
# -----------------------------------------------------------------------------

# Redis is optional. Set to false to run without a cache (cache-miss mode).
# Set to true after starting Redis (see README).
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# Backend — Cache / Circuit-Breaker Tuning
# -----------------------------------------------------------------------------

# Default Redis TTL for GCP metric keys (seconds).
GCP_CACHE_TTL_SECONDS=60

# How often the background pre-warm loop runs (seconds).
GCP_PREWARM_INTERVAL_SECONDS=15

# Maximum time to wait for startup pre-warm before continuing (seconds).
GCP_PREWARM_TIMEOUT_SECONDS=10

# Comma-separated list of environments to pre-warm at startup.
GCP_PREWARM_ENVIRONMENTS=PROD,STAGING

# Comma-separated list of metric categories to pre-warm at startup.
GCP_PREWARM_CATEGORIES=cloud,database,storage

# Comma-separated list of time periods to pre-warm at startup.
GCP_PREWARM_PERIODS=1h,24h

# Number of consecutive GCP API failures before the circuit breaker opens.
GCP_CIRCUIT_FAILURE_THRESHOLD=5

# Seconds the GCP circuit breaker stays open before probing recovery.
GCP_CIRCUIT_OPEN_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Backend — API Server
# -----------------------------------------------------------------------------

# Host and port for uvicorn.
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated allowed origins.
# Use * only in development; the backend disables credentials for wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Frontend — Vite (must be prefixed with VITE_)
# -----------------------------------------------------------------------------

# Base URL for all API calls from the frontend.
# In development Vite proxies /api → http://localhost:8000, so keep this empty.
# In production, set to the full backend URL: https://api.your-domain.com
VITE_API_BASE_URL=

# X-User-Role header sent with every API request (matches backend RBAC).
# Valid values: VIEW_ONLY | INFRA_ADMIN
VITE_USER_ROLE=INFRA_ADMIN

# Poll interval for live GCP metrics auto-refresh (milliseconds).
# Set to 0 to disable polling.
VITE_METRICS_POLL_MS=30000

# When "true", the frontend always uses mock data (no backend calls).
# Useful for local UI development without a running backend.
VITE_USE_MOCK_DATA=false
